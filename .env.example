# Optional dictionary endpoint. The server falls back to AI when no dictionary result is available.
DICTIONARY_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# OpenAI-compatible provider. Keep the key on the server; never expose it through VITE_* variables.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
PORT=8787
